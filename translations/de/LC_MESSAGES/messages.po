#: templates/card_form.html:9
msgid "Defines what this card plays. The ESPuino picks it up on next tap."
msgstr ""
"Legt fest, was diese Karte abspielt. Der ESPuino übernimmt das beim "
"nächsten Auflegen."

#: templates/card_form.html:10
#, python-format
msgid "For ESPuino: %(device)s"
msgstr "Für ESPuino: %(device)s"

